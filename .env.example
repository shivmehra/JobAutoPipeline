# API Keys
APIFY_API_TOKEN=your apify_api_token_here

# Configuration
EXCEL_FILE_PATH=job_results.xlsx
EXCEL_SHEET_NAME=Job Results
OLLAMA_MODEL=ollama_model_name_here
FILTER_DOCUMENT_PATH=filter_criteria.docx
NORMALIZED_DATA_PATH=normalized_data.json
WEBHOOK_PORT=5000
# Actor IDs and Run Inputs
ACTOR_IDS_FILE=C:/custom/path/actors.json //This file should contain a JSON array of actor IDs, e.g., ["actor_id_1", "actor_id_2"]
ACTOR_RUN_INPUTS_FILE=C:/custom/path/actor_inputs.json //This file should contain a JSON object mapping actor IDs to their run inputs/payloads, e.g., {"actor_id_1": {"input_key": "input_value"}, "actor_id_2": {"input_key": "input_value"}}